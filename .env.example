# Twilio WhatsApp
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Superviseur - numero WhatsApp pour recevoir les alertes
ASSISTANT_WHATSAPP_NUMBER=+225XXXXXXXXX

# Admin panel
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changez_ce_mot_de_passe

# Base de donnees Supabase (PostgreSQL)
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-eu-west-1.pooler.supabase.com:6543/postgres

# Secret pour proteger le cron
CRON_SECRET=un_secret_aleatoire

# Stripe (abonnement)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...

# Google Sheets (optionnel)
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SHEETS_ID=
