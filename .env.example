# WhatsApp Cloud API (Meta)
WHATSAPP_TOKEN=your_meta_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=nissa_verify

# Assistante - numero WhatsApp pour recevoir les alertes (format: +227XXXXXXXX)
ASSISTANT_WHATSAPP_NUMBER=+227XXXXXXXXX

# Base de donnees Supabase (PostgreSQL)
# Trouve dans : Supabase > Settings > Database > Connection string > URI
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-eu-west-1.pooler.supabase.com:6543/postgres

# Secret pour proteger le cron (Vercel Cron envoie ce token)
CRON_SECRET=un_secret_aleatoire_ici

# Google Sheets (optionnel)
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SHEETS_ID=your_spreadsheet_id
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
